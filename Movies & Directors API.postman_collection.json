							"script": {
								"exec": [
									"pm.test(\"Status respons adalah 200 OK\", () => {\r",
									"  pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Header Content-Type mengandung application/json\", () => {\r",
									"  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
									"});\r",
									"\r",
									"pm.test(\"Body respons adalah array atau berisi key message & data\", () => {\r",
									"  const jsonData = pm.response.json();\r",
									"  // Jika API mengembalikan array langsung\r",
									"  if (Array.isArray(jsonData)) {\r",
									"    pm.expect(jsonData).to.be.an('array');\r",
									"  } else {\r",
									"    // Jika API mengembalikan { message: \"...\", data: [...] }\r",
									"    pm.expect(jsonData).to.have.property('data');\r",
									"    pm.expect(jsonData.data).to.be.an('array');\r",
									"  }\r",
									"});\r",
									""
								],
